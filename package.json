{
  "name": "skia-pts-canvas",
  "version": "0.1.0",
  "description": "A deterministic Pts canvas adapter for rendering raster images with skia-canvas in Node.js",
  "license": "Apache-2.0",
  "author": "William Ngan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamngan/skia-pts-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/williamngan/skia-pts-canvas/issues"
  },
  "homepage": "https://github.com/williamngan/skia-pts-canvas#readme",
  "type": "module",
  "sideEffects": false,
  "private": true,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "tsdown",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:types && pnpm test:pack && pnpm package:check",
    "example": "pnpm build && node examples/basic-card.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "package:check": "publint && attw --pack .",
    "test": "vitest run",
    "test:pack": "node scripts/test-packed.mjs",
    "test:types": "tsc -p test/fixtures/strict-types/tsconfig.nodenext.json && tsc -p test/fixtures/strict-types/tsconfig.node16.json",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "pts": "github:williamngan/pts#revamp",
    "skia-canvas": "^3.0.8"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@types/node": "24.5.2",
    "eslint": "10.8.1",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "pts": "github:williamngan/pts#revamp",
    "publint": "0.3.23",
    "skia-canvas": "3.0.8",
    "tsdown": "0.22.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
